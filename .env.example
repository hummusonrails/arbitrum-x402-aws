# Provider deploy time
# CDP API key ID (the "name" field from the JSON file CDP gives you when creating an API key)
CDP_API_KEY_ID=

# CDP API key EC private key in PEM format (the "privateKey" field from the same JSON file)
# Multi line PEM. Wrap the value in double quotes or use \n escapes for newlines.
CDP_PRIVATE_KEY=

# EVM address that receives USDC payments on Arbitrum One
RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# Price per request in USDC base units (6 decimals). 10000 = $0.01
PRICE_USDC=10000

# Agent run time
# Set this from the CDK output DistributionDomainName after deploy
RESOURCE_URL=https://example.cloudfront.net/report

# --- AgentCore agent (apps/agent) ---
# AWS region for AgentCore payments. Must be one of: us-east-1, us-west-2, eu-central-1, ap-southeast-2
AGENTCORE_REGION=us-east-1

# Stable identifier for the end-user owning the wallet. Any string.
AGENTCORE_USER_ID=x402-aws-demo-user

# Wallet provider: CoinbaseCDP or StripePrivy
AGENTCORE_PROVIDER=CoinbaseCDP

# Email associated with the embedded wallet (used as linkedAccount)
AGENTCORE_LINKED_EMAIL=

# Per-run spending budget (USD)
AGENTCORE_MAX_SPEND_USD=1.00
AGENTCORE_SESSION_EXPIRY_MINUTES=60

# (Optional) Override the AgentCore service role ARN; defaults to
# arn:aws:iam::<account>:role/AgentCorePaymentsResourceRetrievalRole
# AGENTCORE_SERVICE_ROLE_ARN=

# Path to the CDP API key JSON file (re-used by setup-agent for wallet provisioning)
CDP_API_KEY_FILE=./cdp_api_key.json

# CDP Wallet Secret. Required by AgentCore for embedded wallet signing operations.
# Generate this in the Coinbase Developer Platform under Project > Wallet > Embedded Wallets > Policies.
# Enable "Delegated signing" first.
CDP_WALLET_SECRET=

# Populated by setup-agent (do NOT set manually; copy from setup-agent output)
PAYMENT_MANAGER_ARN=
PAYMENT_INSTRUMENT_ID=
PAYMENT_SESSION_ID=
